# Base URL for server-side fetches (Next.js Node runtime)
BACKEND_INTERNAL_URL=http://localhost:5000/api/v1

# Public URL accessible from the browser (or Next.js proxy path)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Stripe publishable key (test mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key

# Frontend application public URL (used for payment redirect return URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
